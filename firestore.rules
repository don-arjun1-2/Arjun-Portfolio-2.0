rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles: owner can read and write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Contact Inquiries: visitors can create inquiries; owners can view their sent inquiries
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.name is string &&
                       request.resource.data.email is string &&
                       request.resource.data.message is string;
      allow read: if isAuthenticated() && (resource.data.senderUid == request.auth.uid || request.auth.token.email == 'arjun4275120@gmail.com');
      allow update, delete: if isAuthenticated() && request.auth.token.email == 'arjun4275120@gmail.com';
    }

    // Voice conversation sessions: authenticated users can store and inspect their own sessions
    match /voice_sessions/{sessionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'arjun4275120@gmail.com');
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
